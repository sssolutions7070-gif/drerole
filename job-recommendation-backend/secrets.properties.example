# Copy to secrets.properties (untracked) and fill in. Environment variables of the same name override it.
DB_PASSWORD=change-me
# Optional: shared key the proctoring service must send; when empty only loopback callers are trusted
# PROCTORING_API_KEY=change-me-to-a-long-random-string
# Required only if you want to turn on two-factor auth: a base64 AES-256 key encrypting stored
# TOTP secrets. Generate with: openssl rand -base64 32
# TWO_FACTOR_KEY=change-me-to-a-real-generated-key
# Optional: create a demo account at startup (leave unset in production)
# app.demo-user.email=demo@example.com
# app.demo-user.password=change-me
