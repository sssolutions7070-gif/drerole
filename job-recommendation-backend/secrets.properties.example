# Copy to secrets.properties (untracked) and fill in. Environment variables of the same name override it.
DB_PASSWORD=change-me
# Optional: shared key the proctoring service must send; when empty only loopback callers are trusted
# PROCTORING_API_KEY=change-me-to-a-long-random-string
# Required only if you want to turn on two-factor auth: a base64 AES-256 key encrypting stored
# TOTP secrets. Generate with: openssl rand -base64 32
# TWO_FACTOR_KEY=change-me-to-a-real-generated-key
# Optional: create a demo account at startup (leave unset in production)
# app.demo-user.email=demo@example.com
# app.demo-user.password=change-me

# Optional: "Sign in with Google" / "Sign in with LinkedIn". Each button only appears once its
# own client id/secret are both set - leave a provider's two lines unset to hide just that button.
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web
# application) -> Authorized redirect URI: http://localhost:8081/api/auth/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret
# LinkedIn: www.linkedin.com/developers/apps -> create app -> Auth tab -> Authorized redirect URI:
# http://localhost:8081/api/auth/oauth/linkedin/callback (also request the "Sign In with LinkedIn
# using OpenID Connect" product)
# LINKEDIN_OAUTH_CLIENT_ID=change-me-linkedin-client-id
# LINKEDIN_OAUTH_CLIENT_SECRET=change-me-linkedin-client-secret
# This server's own public base URL - only needs to change if it's not running on localhost:8081
# BACKEND_BASE_URL=http://localhost:8081

# Optional: lets a candidate or recruiter connect their Google Calendar so scheduled interviews
# push there automatically, instead of them downloading the .ics file by hand every time. This is
# a separate OAuth client from "Sign in with Google" above - that one never asks for calendar
# access. console.cloud.google.com -> APIs & Services -> enable the "Google Calendar API" ->
# Credentials -> OAuth client ID (Web application) -> Authorized redirect URI:
# http://localhost:8081/api/calendar/google/callback
# GOOGLE_CALENDAR_CLIENT_ID=change-me.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=change-me-google-calendar-client-secret

# Optional: a TURN server for video interviews, needed only as a relay of last resort for peers
# behind strict NATs/firewalls that a plain STUN server can't get through (most connections don't
# need one - the default STUN-only config already works for the common case). A free way to test
# is Twilio's or Cloudflare's TURN service, or self-host with coturn.
# WEBRTC_TURN_URL=turn:turn.example.com:3478
# WEBRTC_TURN_USERNAME=change-me
# WEBRTC_TURN_CREDENTIAL=change-me

# Optional: recruiter subscriptions via Stripe. Every recruiter is on the FREE tier without any
# of this set; the "Upgrade to Pro" button just reports the server isn't configured for it yet.
# dashboard.stripe.com/apikeys -> Secret key (use a *test* key while developing, starts sk_test_)
# STRIPE_SECRET_KEY=sk_test_change-me
# dashboard.stripe.com/products -> create a recurring Price for the Pro plan -> its ID (price_...)
# STRIPE_PRICE_ID_PRO=price_change-me
# dashboard.stripe.com/webhooks -> add an endpoint at <backend>/api/webhooks/stripe listening for
# checkout.session.completed, customer.subscription.updated, customer.subscription.deleted ->
# its signing secret (whsec_...). Locally, the Stripe CLI's `stripe listen` prints one instead.
# STRIPE_WEBHOOK_SECRET=whsec_change-me

# Optional: AI mock-interview practice for candidates. Without a key, starting a practice session
# just reports the server isn't configured for it yet.
# console.anthropic.com/settings/keys -> Create key
# ANTHROPIC_API_KEY=sk-ant-change-me
# Optional: override the model used to generate questions/feedback (defaults to a fast, cheap one)
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
